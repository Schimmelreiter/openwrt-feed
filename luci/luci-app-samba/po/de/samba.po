msgstr "Allgemeine Einstellungen"

#: applications/luci-app-samba/luasrc/model/cbi/samba.lua:13
msgid "Hostname"
msgstr "Hostname"

#: applications/luci-app-samba/luasrc/model/cbi/samba.lua:75
