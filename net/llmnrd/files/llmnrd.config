# /etc/config/llmnrd - see `llmnrd --help`
#
# enabled    1 = start the daemon
# interface  logical networks (from /etc/config/network) to answer on;
#            one llmnrd instance per network, never put WAN here
# hostname   name to answer for (default: system host name)
# ipv6       1 = also answer LLMNR queries over IPv6

config llmnrd 'main'
	option enabled '1'
	list interface 'lan'
	option ipv6 '1'
	# option hostname 'myrouter'
