#!/bin/sh /etc/rc.common
# Copyright (C) 2008-2012 OpenWrt.org
#
# Samba 3.6: generates /var/etc/smb.conf from /etc/samba/smb.conf.template
# and /etc/config/samba, then runs smbd, nmbd (unless NetBIOS is disabled)
# and wsdd2 (WS-Discovery for the Windows "Network" folder, if installed).
# Documentation: /etc/config.readme/samba.readme

START=60
USE_PROCD=1

SMB_CONF=/var/etc/smb.conf

smb_header() {
	config_get samba_iface "$1" interface "loopback lan"

	# resolve interfaces
	samba_devices=$(
		. /lib/functions/network.sh

		for net in $samba_iface; do
			network_is_up "$net" || continue
			network_get_device device "$net"
			echo -n "${device:-$net} "
		done
	)

	local hostname="$(uci_get system.@system[0].hostname)"

	config_get samba_name "$1" name "${hostname:-OpenWrt}"
	config_get samba_workgroup "$1" workgroup "${hostname:-OpenWrt}"
	config_get description "$1" description "Samba on ${hostname:-OpenWrt}"
	config_get charset "$1" charset "UTF-8"

	mkdir -p /var/etc
	sed -e "s#|NAME|#$samba_name#g" \
		-e "s#|WORKGROUP|#$samba_workgroup#g" \
		-e "s#|DESCRIPTION|#$description#g" \
		-e "s#|INTERFACES|#$samba_devices#g" \
		-e "s#|CHARSET|#$charset#g" \
		/etc/samba/smb.conf.template > "$SMB_CONF"

	local homes
	config_get_bool homes "$1" homes 0
	[ "$homes" -gt 0 ] && {
		cat <<EOT >> "$SMB_CONF"

[homes]
	comment     = Home Directories
	browsable   = no
	read only   = no
	create mode = 0750
EOT
	}

	# WS-Discovery settings (used by start_wsdd2)
	config_get_bool wsdd2_enabled "$1" wsdd2 1
	local key
	wsdd2_bootinfo=""
	# defaults for vendor/model: the board model, e.g. "Linksys WRT1900ACS"
	local board_model="$(cat /tmp/sysinfo/model 2>/dev/null)"
	for key in vendor model serial sku vendorurl modelurl presentationurl category; do
		local val
		config_get val "$1" "wsdd2_$key"
		[ -z "$val" ] && [ "$key" = vendor ] && val="${board_model%% *}"
		[ -z "$val" ] && [ "$key" = model ] && val="${board_model#* }"
		# the -b list is comma separated, so values must not contain commas
		val="$(echo "$val" | tr -d ',')"
		[ -n "$val" ] && wsdd2_bootinfo="${wsdd2_bootinfo:+$wsdd2_bootinfo,}$key:$val"
	done

	[ -L /etc/samba/smb.conf ] || ln -nsf "$SMB_CONF" /etc/samba/smb.conf
}

smb_add_share() {
	local name
	local path
	local users
	local read_only
	local guest_ok
	local create_mask
	local dir_mask
	local browseable

	config_get name "$1" name
	config_get path "$1" path
	config_get users "$1" users
	config_get read_only "$1" read_only
	config_get guest_ok "$1" guest_ok
	config_get create_mask "$1" create_mask
	config_get dir_mask "$1" dir_mask
	config_get browseable "$1" browseable

	[ -z "$name" ] || [ -z "$path" ] && return

	printf '\n[%s]\n\tpath = %s\n' "$name" "$path" >> "$SMB_CONF"
	[ -n "$users" ] && printf '\tvalid users = %s\n' "$users" >> "$SMB_CONF"
	[ -n "$read_only" ] && printf '\tread only = %s\n' "$read_only" >> "$SMB_CONF"
	[ -n "$guest_ok" ] && printf '\tguest ok = %s\n' "$guest_ok" >> "$SMB_CONF"
	[ -n "$create_mask" ] && printf '\tcreate mask = %s\n' "$create_mask" >> "$SMB_CONF"
	[ -n "$dir_mask" ] && printf '\tdirectory mask = %s\n' "$dir_mask" >> "$SMB_CONF"
	[ -n "$browseable" ] && printf '\tbrowseable = %s\n' "$browseable" >> "$SMB_CONF"
}

init_config() {
	config_load samba
	CONFIG_APPEND=1 UCI_CONFIG_DIR=/var/run/config config_load samba

	config_foreach smb_header samba
	config_foreach smb_add_share sambashare
}

# true if the generated smb.conf disables NetBIOS (then nmbd would exit at once)
netbios_disabled() {
	grep -qiE '^[[:blank:]]*disable netbios[[:blank:]]*=[[:blank:]]*(yes|true|1)' "$SMB_CONF"
}

start_wsdd2() {
	[ -x /usr/bin/wsdd2 ] && [ "$wsdd2_enabled" = 1 ] || return 0

	local dev ifname=""
	for dev in $samba_devices; do
		[ "$dev" = lo ] && continue
		ifname="$dev"
		break
	done

	procd_open_instance wsdd2
	procd_set_param command /usr/bin/wsdd2 -N "$samba_name" -G "$samba_workgroup"
	[ -n "$ifname" ] && procd_append_param command -i "$ifname"
	# llmnrd already answers LLMNR - let wsdd2 do WS-Discovery only
	[ -x /etc/init.d/llmnrd ] && /etc/init.d/llmnrd enabled && procd_append_param command -w
	[ -n "$wsdd2_bootinfo" ] && procd_append_param command -b "$wsdd2_bootinfo"
	procd_set_param respawn
	procd_set_param file "$SMB_CONF"
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger samba

	local i
	for i in $samba_iface; do
		procd_add_reload_interface_trigger "$i"
	done
}

start_service() {
	init_config

	procd_open_instance smbd
	procd_add_mdns "smb" "tcp" "445"
	procd_set_param command /usr/sbin/smbd -F
	procd_set_param respawn
	procd_set_param file "$SMB_CONF"
	procd_close_instance

	if netbios_disabled; then
		logger -t samba "NetBIOS disabled in smb.conf.template, nmbd not started"
	else
		procd_open_instance nmbd
		procd_set_param command /usr/sbin/nmbd -F
		procd_set_param respawn
		procd_set_param file "$SMB_CONF"
		procd_close_instance
	fi

	start_wsdd2
}
